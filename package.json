{
  "name": "hostel-room-allocation",
  "version": "1.0.0",
  "private": true,
  "description": "Policy-Driven Hostel Allocation Engine - Week 5 Foundation",
  "scripts": {
    "dev": "concurrently -n \"NEXT,SERVER\" -c \"cyan,magenta\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "next dev -p 3000",
    "dev:server": "node server/index.js",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb-memory-server": "^9.4.0",
    "mongoose": "^8.5.2",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
